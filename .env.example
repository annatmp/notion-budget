# ---------------------------------------------------------------------------
# Budget Tracker — environment template
#
# Copy to `.env.local` and fill in real values. Never commit a filled file:
# `.gitignore` excludes `.env*` apart from this template, and the pre-commit
# guard refuses a commit containing credentials.
#
# This file lists every variable the config schema declares. A test asserts the
# two cannot drift apart, so adding a variable to the schema without adding it
# here fails the build (see src/config/schema.ts).
# ---------------------------------------------------------------------------

# --- Notion binding --------------------------------------------------------
# Internal integration token. Share ONLY the Budget and Spending databases with
# this integration, never their parent page: sharing a page cascades to its
# children and would hand the token the whole trip workspace (design.md).
NOTION_TOKEN=

# 2025-09-03 or later. The Budget database has more than one data source, so
# every call must be data_source_id-scoped, which older versions cannot express.
NOTION_VERSION=2025-09-03

# Data source IDs, not database IDs — the Budget database is ambiguous by ID.
NOTION_BUDGET_DATA_SOURCE_ID=
NOTION_SPENDING_DATA_SOURCE_ID=

# Exact property names as they appear in Notion. Configuration rather than
# constants on purpose: retargeting the app at another budget is an edit here.
NOTION_BUDGET_TITLE_PROPERTY=
NOTION_BUDGET_CATEGORY_PROPERTY=
NOTION_SPENDING_TITLE_PROPERTY=
NOTION_SPENDING_PRICE_PROPERTY=
NOTION_SPENDING_CURRENCY_PROPERTY=
NOTION_SPENDING_DATE_PROPERTY=
NOTION_SPENDING_BUDGET_RELATION_PROPERTY=

# --- Budget vocabulary -----------------------------------------------------
# Select option names are matched literally: `EURO` is not `EUR`, and the live
# budget spells it `Accomodation`. Both are config values so nobody "fixes"
# them later (design.md, Config binds names, not just IDs).
# Comma-separated.
NOTION_CATEGORIES=
NOTION_CURRENCIES=
DEFAULT_CURRENCY=

# "Yesterday" resolves against the trip's local date, or late-evening spends
# land on the wrong day.
TRIP_TIMEZONE=Australia/Melbourne

# --- DeepSeek --------------------------------------------------------------
DEEPSEEK_API_KEY=
# Must accept images: `deepseek-v4-pro` is text-only.
DEEPSEEK_MODEL_ID=deepseek-flash

# --- Access control --------------------------------------------------------
# Cloudflare Access application used to verify the CF-Authorization JWT on every
# request. The app keeps no accounts of its own and never trusts the identity
# header on its own (design.md, Authentication is delegated to a proxy).
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Local development only. Refuses to start when APP_ENV is `production`.
DEV_AUTH_BYPASS=false

# Daily per-identity ceiling on the capture endpoints, bounding what an
# authenticated caller can spend on the model.
CAPTURE_DAILY_LIMIT=

# --- Runtime ---------------------------------------------------------------
# `production` enables the guard that refuses DEV_AUTH_BYPASS.
APP_ENV=development
